# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" = demo: fictional-clinic notices shown, search engines blocked, clinic schema.org disabled.
# Set to "false" ONLY when the site is customised for a real, operating clinic.
NEXT_PUBLIC_DEMO_MODE=true

# ---------- Clinic contact (NOT the agency's number) ----------
NEXT_PUBLIC_CLINIC_PHONE=+92 300 0000000
NEXT_PUBLIC_CLINIC_EMAIL=hello@smilecare.example
# Digits only, international format, no "+" (e.g. 923001234567). Leave empty if not set.
NEXT_PUBLIC_CLINIC_WHATSAPP=
NEXT_PUBLIC_MAP_EMBED_URL=

# ---------- Analytics (optional) ----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# ---------- Email via Resend (optional, server-only) ----------
RESEND_API_KEY=
EMAIL_FROM=SmileCare <enquiries@yourdomain.com>
EMAIL_TO=clinic-inbox@yourdomain.com

# ---------- Supabase (optional, server-only) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
